// Cloudflare config: a static-assets-only deployment (Cloudflare Pages is now part of Workers).
// No Worker code and no build step: Cloudflare serves the public/ folder, honouring public/_headers.
{
  "name": "bluewave-dashboard",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public"
  }
}
